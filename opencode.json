{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{file:~/.secrets/deepseek-key}"
      },
      "models": {
        "deepseek-chat": {}
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "vibium": {
      "type": "local",
      "command": ["npx", "-y", "vibium", "mcp"],
      "enabled": true
    }
  }
}
